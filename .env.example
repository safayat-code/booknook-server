PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=booknook
# Origin(s) of the Next.js client, comma separated. Also the Better Auth base URL.
CLIENT_URL=http://localhost:3000
# Base URL of the Next.js app that runs Better Auth (issuer of the JWTs)
AUTH_URL=http://localhost:3000
